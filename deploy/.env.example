# Секреты и настройки машины. НЕ коммитить заполненный файл.
#
# Terraform его не создаёт с значениями намеренно: всё, что попадает в
# переменные terraform, попадает и в state, а state однажды оказывается
# в репозитории или в бакете без пароля.

# --- обязательное -------------------------------------------------------------

# Пароль Postgres. Наружу база не смотрит (портов у неё нет ни в compose,
# ни в файрволе), но пароль всё равно длинный: контейнеры в одной сети.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Домен API. A-запись обязана указывать на этот сервер ДО первого старта
# Caddy: сертификат выпускается проверкой по HTTP-01.
QIYMET_DOMAIN=api.qiymet.az

# Почта для Let's Encrypt: туда придёт письмо, если продление сломается.
QIYMET_ACME_EMAIL=

# --- мониторинг ---------------------------------------------------------------

# Бот и чат для алертов. Без них алерты пишутся только в лог, то есть их
# никто не увидит, пока специально не пойдёт смотреть.
#   1. @BotFather -> /newbot -> токен
#   2. написать боту любое сообщение
#   3. curl "https://api.telegram.org/bot<ТОКЕН>/getUpdates" -> chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- пульс во внешний монитор -------------------------------------------------

# Монитор, который спрашивает наш API, узнает про упавший API. Про вставшее
# РАСПИСАНИЕ он не узнает никогда: API продолжит бодро отдавать вчерашние цены.
# Пульс работает наоборот — молчание само по себе становится сигналом.
# Период на стороне монитора ставить 4 часа: сбор ходит каждые 3.
HEARTBEAT_URL_CRAWL=

# --- пуши ---------------------------------------------------------------------

# Без QIYMET_FCM_PROJECT_ID уведомления работают в сухом прогоне: тексты
# печатаются в лог, никому ничего не уходит. Это рабочий режим для первых
# дней, пока не выверены правила отправки.
QIYMET_FCM_PROJECT_ID=

# Путь на ХОСТЕ к ключу сервисного аккаунта Firebase. Монтируется в контейнер
# только на чтение. Если не задан, подставляется /dev/null и FCM молчит.
QIYMET_FCM_KEY_PATH=/etc/qiymet/fcm-service-account.json
