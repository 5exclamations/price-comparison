# --- сборка и кеши -----------------------------------------------------------
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/ios/Pods/
app/ios/Flutter/ephemeral/
app/ios/.symlinks/
app/android/.gradle/
app/android/local.properties
app/.idea/
**/__pycache__/
.pytest_cache/
.DS_Store

# --- локальное состояние Xcode ------------------------------------------------
# Раскладка окон, точки останова и выбранная схема — у каждого своя. Podfile.lock
# и xcshareddata/swiftpm/Package.resolved, наоборот, КОММИТЯТСЯ: они фиксируют
# версии зависимостей, иначе CI и машина разработчика собирают разное.
**/xcuserdata/
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
app/ios/Flutter/Flutter.podspec

# --- состояние локальных инструментов -----------------------------------------
.claude/
.venv/
venv/

# --- секреты -----------------------------------------------------------------
# Пароль базы, токен телеграма, ключ FCM, ключ подписи Android. Ни один из них
# не должен уехать в репозиторий даже один раз: история хранит всё.
deploy/.env
app/android/key.properties
*.jks
*.keystore
fcm-service-account*.json

# --- данные прогонов ---------------------------------------------------------
deploy/logs/
deploy/backups/
pipeline/state/

# Служебные файлы SQLite. Сам pipeline/qiymet.db КОММИТИТСЯ: без него джоб
# `data` в CI проверял бы пустую базу, а на синтетике не воспроизводится ни
# одна из поломок, ради которых проверки написаны.
pipeline/qiymet.db-wal
pipeline/qiymet.db-shm

# --- Retail Price Intelligence Platform (rpi) ----------------------------------
# Generated, reproducible from `make seed`; never commit synthetic or real feeds.
data/landing/
data/truth/
data/reports/
data/screenshots_raw/
warehouse/target/
warehouse/logs/
warehouse/dbt_packages/
*.egg-info/
.prefect/
