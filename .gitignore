# --- сборка и кеши -----------------------------------------------------------
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/ios/Pods/
app/ios/Flutter/ephemeral/
app/ios/.symlinks/
app/android/.gradle/
app/android/local.properties
app/.idea/
**/__pycache__/
.pytest_cache/
.DS_Store

# --- секреты -----------------------------------------------------------------
# Пароль базы, токен телеграма, ключ FCM, ключ подписи Android. Ни один из них
# не должен уехать в репозиторий даже один раз: история хранит всё.
deploy/.env
app/android/key.properties
*.jks
*.keystore
fcm-service-account*.json

# --- данные прогонов ---------------------------------------------------------
deploy/logs/
deploy/backups/
pipeline/state/

# Служебные файлы SQLite. Сам pipeline/qiymet.db КОММИТИТСЯ: без него джоб
# `data` в CI проверял бы пустую базу, а на синтетике не воспроизводится ни
# одна из поломок, ради которых проверки написаны.
pipeline/qiymet.db-wal
pipeline/qiymet.db-shm
